# 依赖
node_modules/
target/

# 构建产物
dist/
dist-ssr/
build/
*.local
src-tauri/gen/

# 运行时日志（应用实际写的是应用数据目录，这里是兜底）
# 注意必须写成 /logs/：写成 logs/ 会连 src-tauri/src/logs/（源码模块）一起忽略掉，
# 实测踩过——本地能编译，推上去的仓库却缺文件，别人 clone 下来直接编译失败。
/logs/
*.log
npm-debug.log*

# 编辑器与系统
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# 环境变量
.env
.env.*
!.env.example

# 测试覆盖率
coverage/

# updater 签名私钥与本地生成的发布清单（私钥绝不能进仓库）
*.key
/.tauri/
/latest.json
# 本地发版素材（安装包 / latest.json），上传 Release 用，不进仓库
/release-assets/
